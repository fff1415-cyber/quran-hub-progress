RewriteEngine On
RewriteBase /api/

# Health check — /api/health → health.php (بدون المرور بـ index.php)
RewriteRule ^health/?$ health.php [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L]

# Protect config.php from direct access
<Files "config.php">
  Require all denied
</Files>
