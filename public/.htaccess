# ─────────────────────────────────────────────────────────────────────────────
# Hostinger / Apache — SPA for msht.io + subdomains (m1.msht.io, m2.msht.io, …)
#
# Upload to the DOCUMENT ROOT of each vhost (usually public_html).
# If m1.msht.io shows default.php, its docroot is NOT this folder — see:
#   scripts/prepare-hostinger-deploy.mjs  +  DEPLOY.md § Subdomains
# ─────────────────────────────────────────────────────────────────────────────

# Prefer SPA index over Hostinger default.php
DirectoryIndex index.html index.htm

Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Hostinger placeholder — send to SPA
  RewriteRule ^default\.php$ /index.html [L,R=301,NC]

  # PHP API (same docroot: public_html/api/)
  RewriteRule ^api(/|$) - [L]

  # Bearer token for API
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # Static files that exist on disk
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA — all routes → index.html
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
